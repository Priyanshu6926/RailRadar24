# ==========================================
# RailRadar24 — Environment Variables Template
# Copy this file to .env.local and fill in your API keys
# ==========================================

# RailRadar API Key (Required for live train tracking & schedule lookup)
# Get your key at: https://railradar.in/developers
RAILRADAR_API_KEY=your_railradar_api_key_here

# MapTiler Vector Map API Key (Required for MapLibre vector maps)
# Get your key at: https://www.maptiler.com/cloud/
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key_here

# OpenWeatherMap API Key (Required for live station weather intelligence)
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenTopography / OpenTopoData (SRTM 30m elevation profiles)
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key_here

